<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Abstract</vendor>
  <action id="org.abstract.charge-limit">
    <description>Set a system battery charging limit</description>
    <message>Administrator authorization is required to change the battery charging limit and save it for startup.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/abstract/abstract-charge-limit</annotate>
  </action>
</policyconfig>
