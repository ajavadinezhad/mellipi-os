+/* One shared, minute-aligned presentation timer for the locked process.
+ * It never owns a surface: output hotplug can destroy those independently. */
+static struct loop_timer *orbit_clock_timer;
+static void orbit_schedule_clock(struct swaylock_state *state);
+static void orbit_clock_tick(void *data) {
+	struct swaylock_state *state = data;
+	orbit_clock_timer = NULL;
+	if (!state->run_display) return;
+	orbit_schedule_clock(state);
+	orbit_expire_lock_network();
+	damage_state(state);
+}
+static void orbit_schedule_clock(struct swaylock_state *state) {
+	if (orbit_clock_timer || !state->eventloop) return;
+	struct timespec now;
+	int delay = 60000;
+	if (clock_gettime(CLOCK_REALTIME, &now) == 0) {
+		delay = 60000 - (int)(now.tv_sec % 60) * 1000 - (int)(now.tv_nsec / 1000000);
+		if (delay < 1) delay = 1;
+		if (delay > 60000) delay = 60000;
+	}
+	orbit_clock_timer = loop_add_timer(state->eventloop, delay, orbit_clock_tick, state);
+}
