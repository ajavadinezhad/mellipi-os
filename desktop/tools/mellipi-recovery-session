#!/usr/bin/python3 -I
"""Authenticated, shell-independent Xorg emergency terminal; no desktop daemon."""
import os

def main():
    if os.geteuid()==0:raise SystemExit('Start Recovery from the normal sign-in screen, not sudo.')
    if not os.environ.get('DISPLAY') or os.environ.get('WAYLAND_DISPLAY'):raise SystemExit('Choose Mellipi Recovery at the sign-in screen.')
    env=dict(os.environ)
    for key in list(env):
        if key.startswith(('ORBIT_','QT_','QML','PYTHON','LD_','BASH_FUNC_')) or key.startswith(('GTK_','GDK_','GIO_')) or key in ('BASH_ENV','ENV','SHELLOPTS','BASHOPTS','PROMPT_COMMAND','INPUTRC','XENVIRONMENT','XAPPLRESDIR','XFILESEARCHPATH','XUSERFILESEARCHPATH','XDG_DATA_DIRS','XDG_CONFIG_DIRS','XDG_CACHE_HOME','XDG_STATE_HOME'):env.pop(key,None)
    # The recovery window must not read per-user terminal or GTK settings.
    # The console restores the authenticated account's real HOME itself.
    env.update(PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin',HOME='/',XENVIRONMENT='/dev/null',INPUTRC='/dev/null',XDG_CURRENT_DESKTOP='MellipiRecovery',XDG_SESSION_DESKTOP='mellipi-recovery',GDK_BACKEND='x11',GTK_THEME='Adwaita',XDG_CONFIG_HOME='/nonexistent',XDG_DATA_HOME='/nonexistent')
    os.execve('/usr/bin/python3',['/usr/bin/python3','-I','/usr/lib/abstract/recovery_terminal.py'],env)

if __name__=='__main__':main()
