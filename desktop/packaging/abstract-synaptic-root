#!/usr/bin/python3 -I
"""Fixed Synaptic GUI bridge; authorization is always provided by pkexec."""
import os,re,stat,subprocess,sys,tempfile
from pathlib import Path

def checked_display(uid_text,runtime_text,display):
    if not re.fullmatch(r'[0-9]{1,10}',uid_text or ''):raise ValueError('Missing authenticated caller')
    uid=int(uid_text)
    if uid<1000 or uid>=2**31 or uid==65534:raise ValueError('Expected a regular signed-in user')
    runtime=Path('/run/user')/str(uid)
    if runtime_text!=str(runtime):raise ValueError('Unexpected caller runtime')
    info=runtime.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid!=uid or stat.S_IMODE(info.st_mode)!=0o700:raise ValueError('Unsafe caller runtime')
    name=display
    if display.startswith(str(runtime)+'/'):name=display[len(str(runtime))+1:]
    if not re.fullmatch(r'wayland-[A-Za-z0-9_-]{1,80}',name):raise ValueError('Unexpected Wayland display')
    socket=runtime/name;info=socket.lstat()
    if not stat.S_ISSOCK(info.st_mode) or info.st_uid!=uid:raise ValueError('Unsafe caller display')
    return str(socket)

def run(arguments,environment=None):
    env=os.environ if environment is None else environment
    if os.geteuid()!=0 or len(arguments)!=2:raise ValueError('Use the authenticated package-manager launcher')
    display=checked_display(env.get('PKEXEC_UID',''),arguments[0],arguments[1])
    with tempfile.TemporaryDirectory(prefix='abstract-packages-',dir='/run') as runtime:
        os.chmod(runtime,0o700)
        child={'PATH':'/usr/sbin:/usr/bin:/sbin:/bin','HOME':'/root','USER':'root','LOGNAME':'root','LANG':'C.UTF-8','GDK_BACKEND':'wayland','WAYLAND_DISPLAY':display,'XDG_RUNTIME_DIR':runtime}
        return subprocess.run(['/usr/sbin/synaptic'],env=child,cwd='/',check=False).returncode
if __name__=='__main__':
    try:raise SystemExit(run(sys.argv[1:]))
    except (ValueError,OSError) as error:print('Could not open package manager: '+str(error),file=sys.stderr);raise SystemExit(1)
